{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "paths": {
      "solid-js": ["../../node_modules/solid-js/types/index.d.ts"],
      "solid-js/*": ["../../node_modules/solid-js/*"]
    }
  },
  "include": ["./**/*.tsx"]
}
