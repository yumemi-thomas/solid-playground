{
  "name": "solid-playground-restructured",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "workspaces": [
    "./packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "start": "cd packages/playground && pnpm start",
    "build": "pnpm panda codegen && cd packages/playground && pnpm build",
    "dev": "cd packages/playground && pnpm dev",
    "test:lint-api": "node --experimental-strip-types scripts/smoke-lint-api.mjs",
    "test:examples": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-examples.mjs",
    "test:linter-worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test packages/solid-repl/test/linter-handlers.test.mjs",
    "test:service-worker": "node --test packages/playground/test/service-worker.test.mjs",
    "generate:example-lint-cache": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-examples.mjs --write-cache",
    "panda:watch": "panda codegen --watch",
    "format": "oxfmt .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.0",
    "oxlint": "^1.75.0",
    "solid-checker": "0.4.0-beta.1",
    "solid-js-v2": "npm:solid-js@2.0.0-rc.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@pandacss/dev": "^1.11.5",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.60.0"
  },
  "packageManager": "pnpm@11.17.0"
}
